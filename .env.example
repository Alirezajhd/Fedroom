# Copy to .env and adjust. Never commit the real .env file.

# --- Coordinator service ---
FEDROOM_HOST=0.0.0.0
FEDROOM_PORT=8000
FEDROOM_TICK_INTERVAL=2.0
FEDROOM_MAX_UPDATE_NORM=

# --- Metadata store (SQLite by default; swap for Postgres in prod) ---
DATABASE_URL=sqlite:///./data/fedroom.db
# DATABASE_URL=postgresql+psycopg2://fedroom:fedroom@postgres:5432/fedroom

# --- Checkpoint storage: "local" or "s3" (MinIO-compatible) ---
CHECKPOINT_BACKEND=s3
LOCAL_CHECKPOINT_DIR=./data/checkpoints
S3_CHECKPOINT_BUCKET=flaas-models
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=fedroomadmin
S3_SECRET_KEY=fedroomsecret

# --- Experiment tracking ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Ray / KubeRay execution layer ---
RAY_ADDRESS=auto
